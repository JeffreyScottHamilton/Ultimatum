#!/usr/bin/env python3
"""Ultimatum default: a UserPromptSubmit hook. Local, stdlib only, no network.

Ultimatum is the default way of answering, not only for code. ultlib/pick.py sorts
the prompt; `--scope core` (run by the ultimatum plugin) adds one short line:
- chat (questions, writing help, small talk): answer in Ultimatum's style, easy
  first, deeper only when asked. ULTIMATUM_STYLE=0 drops this line.
- work (fix, build, test, review, debug, ship code): start ultimatum:work.
- website (build, redesign or fix a site): start ultimatum:website.
Any other scope: nothing. A prompt that starts with "/"
is an explicit command and is left alone. ULTIMATUM_AUTO=0 turns it all off. Any
error lets the prompt through unchanged.
"""
import json
import os
import sys

def _start(skill: str, what: str, tail: str) -> str:
    return (f"Ultimatum: this request is {what}. Start the {skill} skill now "
            f"(Skill tool, skill \"{skill}\", args: the user's request){tail}")


STYLE = ("Ultimatum style: answer first in 1-3 plain lines, no preamble; go deeper or use "
         "helpers only if the question needs it or the user asks.")

def note_for(kind: str, prompt: str, env=os.environ) -> str:
    if kind == "work":
        return _start("ultimatum:work", "coding work", " and follow it.")
    if kind == "chat":
        off = env.get("ULTIMATUM_STYLE", "1").strip().lower() in ("0", "false", "no", "off")
        return "" if off else STYLE
    if kind == "website":
        return _start("ultimatum:website", "website work", " and let it run the whole job.")
    return ""


def _scope(argv: list) -> str:
    for i, a in enumerate(argv):
        if a.startswith("--scope="):
            return a.split("=", 1)[1]
        if a == "--scope" and i + 1 < len(argv):
            return argv[i + 1]
    return "core"


def main() -> int:
    if os.environ.get("ULTIMATUM_AUTO", "1").strip().lower() in ("0", "false", "no", "off"):
        return 0
    if _scope(sys.argv[1:]) != "core":
        return 0
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    try:
        data = json.load(sys.stdin)
        prompt = (data.get("prompt") or "").strip()
        if not prompt or prompt.startswith("/"):
            return 0
        from pathlib import Path
        from ultlib.pick import pick
        cwd = data.get("cwd") or os.getcwd()
        kind = pick(prompt[:2000], root=Path(cwd))
        note = note_for(kind, prompt)
        if not note:
            return 0
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                                 "additionalContext": note}}))
    except Exception:  # never block or break a prompt
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
