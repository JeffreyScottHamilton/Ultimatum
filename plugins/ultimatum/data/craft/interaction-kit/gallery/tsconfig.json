{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "typeRoots": ["./node_modules/@types"], "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom/client": ["./node_modules/@types/react-dom/client"],
      "motion/react": ["./node_modules/motion/react"]
    }
  },
  "include": ["../components/*.ts", "../components/*.tsx", "app.tsx"]
}
