{
  "description": "After a compaction, print the saved handoff back into the chat. On Stop, record local usage observations (counts only, nothing printed; ULTIMATUM_OBSERVE=0 turns it off). Before each prompt, coding work gets one line pointing Claude to /ultimatum:work; plain questions, launch, business, social and video prompts get nothing (ULTIMATUM_AUTO=0 turns it off). Also the chat-size guard, off unless ULTIMATUM_GUARD=1; see the plugin README.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ult\" handoff show 2>/dev/null || true",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ult-guard\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ult-guard\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ult-pick\" --scope core",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ult\" learn observe --hook >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
