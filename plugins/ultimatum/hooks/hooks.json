{
  "description": "After a compaction, print the saved handoff back into the conversation so work continues in the same chat.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ult\" handoff show 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
