{
  "expo": {
    "name": "Demo",
    "version": "1.0",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-image-picker"
    ],
    "ios": {
      "bundleIdentifier": "com.example.demo",
      "buildNumber": "3",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Needed."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefault",
            "NSPrivacyAccessedAPITypeReasons": []
          }
        ]
      }
    }
  }
}
