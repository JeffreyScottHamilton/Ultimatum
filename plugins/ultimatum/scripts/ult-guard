#!/usr/bin/env python3
"""Ultimatum chat-size guard: an opt-in UserPromptSubmit hook. Local, stdlib only.

Off unless ULTIMATUM_GUARD=1. When on, before each prompt it reads the current
chat's transcript; if the last turn re-read more than ULTIMATUM_GUARD_TOKENS
(default 400000), or the chat has been idle longer than ULTIMATUM_GUARD_IDLE_MIN
(default 240) minutes while re-reading more than ULTIMATUM_GUARD_IDLE_TOKENS
(default 150000), it writes a handoff and exits 2. Claude Code then drops the
prompt before it reaches the model (zero model tokens) and shows stderr. A small
idle chat is never blocked: one uncached re-read of it costs little.
The guard blocks a chat once: sending a prompt again in the same chat goes
through, so the user is never locked out. Any error or missing data lets the
prompt through.

The same script is also a SessionStart hook: when a new chat starts (or /clear)
after the guard blocked a prompt, it prints the handoff so Claude resumes the
work from the first message, whatever it says. Each block is resumed once.
"""
import json
import os
import subprocess
import sys
import time

MESSAGE = ("Chat too large. Start a new chat and type: /ultimatum:work resume\n"
           "Or send your message again to continue in this chat.")
PENDING = "guard-pending"
TOKENS_DEFAULT = 400_000  # a safety net above auto-compact (~200k), not the main control
IDLE_MIN_DEFAULT = 240
IDLE_TOKENS_DEFAULT = 150_000  # below this an expired cache is a cheap one-off re-read
RESUME_MAX_AGE = 7 * 24 * 3600
RESUME_MAX_CHARS = 8000


def _num(name, default):
    try:
        return float(os.environ.get(name, default))
    except ValueError:
        return float(default)


def _state(cwd):
    """The project's state dir, without creating it (unlike common.state_dir)."""
    from pathlib import Path
    from ultlib.common import STATE_DIRNAME, project_root
    ext = os.environ.get("ULTIMATUM_STATE_DIR")
    return Path(ext).resolve() if ext else project_root(Path(cwd) if cwd else None) / STATE_DIRNAME


def resume(data) -> int:
    """SessionStart: hand a pending guard handoff to the new chat, once."""
    d = _state(data.get("cwd"))
    marker, handoff = d / PENDING, d / "handoff.md"
    if not marker.is_file() or marker.is_symlink():
        return 0
    fresh = time.time() - marker.stat().st_mtime < RESUME_MAX_AGE
    marker.unlink()
    if not fresh or not handoff.is_file():
        return 0
    text = handoff.read_text(encoding="utf-8", errors="replace")[:RESUME_MAX_CHARS]
    print("The previous chat was stopped by the Ultimatum chat-size guard. Whatever the user's "
          "first message says (e.g. \"continue\"), resume that work: follow the /ultimatum:work "
          "handoff route (resume) with the handoff below, starting at its next unfinished step, "
          "unless the user asks for something else.\n")
    print(text)
    return 0


def main() -> int:
    if os.environ.get("ULTIMATUM_GUARD", "").strip().lower() not in ("1", "true", "yes", "on"):
        return 0
    sys.dont_write_bytecode = True
    here = os.path.dirname(os.path.realpath(__file__))
    sys.path.insert(0, here)
    from pathlib import Path
    from ultlib.context import transcript_stats

    try:
        data = json.load(sys.stdin)
        if data.get("hook_event_name") == "SessionStart":
            return resume(data)
        transcript = Path(data["transcript_path"])
        session = str(data.get("session_id") or "")
        marker = _state(data.get("cwd")) / PENDING
        if session and marker.is_file() and not marker.is_symlink():
            parts = marker.read_text(encoding="utf-8", errors="replace").split()
            if len(parts) > 1 and parts[1] == session:
                marker.unlink()  # resent in the blocked chat: the user chose to stay, let it through
                return 0
        tokens, turns, last = transcript_stats(transcript)
    except Exception:  # no input, no transcript yet, unreadable: never block
        return 0
    limit = _num("ULTIMATUM_GUARD_TOKENS", TOKENS_DEFAULT)
    idle_min = (time.time() - last) / 60 if last else 0
    reason = None
    if tokens > limit:
        reason = f"each turn re-reads ~{tokens:,} tokens"
    elif (idle_min > _num("ULTIMATUM_GUARD_IDLE_MIN", IDLE_MIN_DEFAULT)
          and tokens > _num("ULTIMATUM_GUARD_IDLE_TOKENS", IDLE_TOKENS_DEFAULT)):
        reason = f"idle {int(idle_min)} minutes, so the cache expired and the next turn re-reads everything"
    if not reason:
        return 0

    prompt = str(data.get("prompt") or "")[:500]
    cmd = [sys.executable, os.path.join(here, "ult"), "handoff", "write", "--keep",
           "--evidence", f"ult-guard blocked a prompt ({reason}; {turns} turns)"]
    if prompt:
        cmd += ["--evidence", f"blocked prompt, resend it in the new chat: {prompt}"]
    try:
        r = subprocess.run(cmd, cwd=data.get("cwd") or None, capture_output=True, timeout=20)
        if r.returncode == 0:
            marker.write_text(f"{time.time():.0f} {session}\n")
    except Exception:
        pass
    print(f"[ultimatum] {reason}.\n{MESSAGE}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
