#!/usr/bin/env python3
"""Ultimatum local toolbelt. Standard library only; no network access.

  ult run -- <cmd>          run noisy command: exit code + key lines, raw log kept
  ult log <id|last> [...]   exact raw output (--lines A:B, --grep RE)
  ult logs                  recent runs
  ult search|symbols|refs   scoped, capped code search
  ult map build|summary|query
  ult note|find|get         local full-text evidence store
  ult handoff write|show
  ult scan [...]            security scanners if installed, built-in checks otherwise
  ult findings ...          validate / merge / render security findings
  ult doctor                which optional integrations are present
"""
import argparse
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from ultlib import doctor, handoff, repomap, run, search, store  # noqa: E402

MODULES = [run, search, repomap, store, handoff, doctor]
for optional in ("scan", "findings"):
    try:
        MODULES.append(__import__(f"ultlib.{optional}", fromlist=["register"]))
    except ImportError:
        pass


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="ult", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for m in MODULES:
        m.register(sub)
    args = ap.parse_args(argv)
    try:
        return int(args.func(args) or 0)
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
