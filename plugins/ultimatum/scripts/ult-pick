#!/usr/bin/env python3
"""Ultimatum workflow picker: a UserPromptSubmit hook. Local, stdlib only, no network.

It adds one line of context so Ultimatum starts without a slash command. ultlib/pick.py
decides the workflow; `--scope` decides which ones this copy may announce:
- `--scope core` (the default, run by the ultimatum plugin): other coding work
  (fix, build, test, review, debug, ship) -> start ultimatum:work. Launch-type
  prompts get nothing here.
- `--scope launch` (run by the ultimatum-launch plugin's own hook): website work,
  a standalone clip, a launch, a social media plan or a business question ->
  ultimatum-launch:website, :motion-graphics, :brand-film, :launch, :social-media or :business.
A launch also names its kind's plugin (ultimatum-website-, -ecommerce- or
  -saas-launch) to start instead when installed.
So the Launch teams are only suggested when that plugin is installed.
Plain questions, writing help and small talk get nothing, so ordinary chats pay no
extra tokens. A prompt that starts with "/" is an explicit command and is left alone.
ULTIMATUM_AUTO=0 turns it off. Any error lets the prompt through unchanged.
"""
import json
import os
import sys

def _start(skill: str, what: str, tail: str) -> str:
    return (f"Ultimatum: this request is {what}. Start the {skill} skill now "
            f"(Skill tool, skill \"{skill}\", args: the user's request){tail}")


NOTES = {
    "launch": {
        "website": _start("ultimatum-launch:website", "website work", " and let it run the whole job."),
        "motion": _start("ultimatum-launch:motion-graphics", "a motion graphics clip or video",
                         " and let it run the whole job."),
        "film": _start("ultimatum-launch:brand-film", "an emotional, story-led brand film",
                       "; it gets the story, footage plan and spend approved before anything is bought or rendered."),
        "launch": _start("ultimatum-launch:launch", "a launch",
                         "; it runs intake, Business, Website, Marketing and Motion and brings every approval "
                         "back to the user."),
        "business": _start("ultimatum-launch:business", "a business question",
                           "; advice only, no changes unless asked."),
        "social": _start("ultimatum-launch:social-media", "a social media plan or campaign",
                         "; nothing is posted without approval."),
    },
    "core": {
        "work": _start("ultimatum:work", "coding work", " and follow it."),
    },
}


def _scope(argv: list) -> str:
    for i, a in enumerate(argv):
        if a.startswith("--scope="):
            return a.split("=", 1)[1]
        if a == "--scope" and i + 1 < len(argv):
            return argv[i + 1]
    return "core"


def main() -> int:
    if os.environ.get("ULTIMATUM_AUTO", "1").strip().lower() in ("0", "false", "no", "off"):
        return 0
    notes = NOTES.get(_scope(sys.argv[1:]))
    if not notes:
        return 0
    sys.dont_write_bytecode = True
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    try:
        data = json.load(sys.stdin)
        prompt = (data.get("prompt") or "").strip()
        if not prompt or prompt.startswith("/"):
            return 0
        from pathlib import Path
        from ultlib.pick import pick
        cwd = data.get("cwd") or os.getcwd()
        kind = pick(prompt[:2000], root=Path(cwd))
        note = notes.get(kind)
        if not note:
            return 0
        if kind == "launch":
            from ultlib.teams import kind_plugin, launch_kind
            deeper = kind_plugin(launch_kind(prompt[:2000]))
            if deeper:
                note += (f" If the {deeper} plugin is installed, start `{deeper}:launch` instead: "
                         "it is the same manager with deeper steps for this kind of launch.")
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                                 "additionalContext": note}}))
    except Exception:  # never block or break a prompt
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
