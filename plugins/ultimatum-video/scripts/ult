#!/usr/bin/env python3
"""Ultimatum local toolbelt. Standard library only; no network access.

  ult run -- <cmd>          run noisy command: exit code + key lines, raw log kept
  ult log <id|last> [...]   exact raw output (--lines A:B, --grep RE)
  ult logs                  recent runs
  ult search|symbols|refs   scoped, capped code search
  ult map build|summary|query
  ult note|find|get         local full-text evidence store
  ult handoff write|show
  ult scan [...]            security scanners if installed, built-in checks otherwise
  ult findings ...          validate / merge / render security findings
  ult audit start|finish    security audit: ledger + scan + findings skeleton, then validate + report
  ult doctor                which optional integrations are present
  ult retro                 lesson candidates from this chat (repeated failures, re-reads, big outputs)
  ult usage report          where Claude's tokens went, avoidable work (local transcripts)
  ult improve ...           propose / apply / measure / keep or roll back a workflow change
  ult route "<task>"        mode + modules + files to read for a task (offline, deterministic)
  ult components "<need>"   offline UI component-library lookup with licences
  ult learn ...             local lessons: observe / add / list / relevant / propose / prune
  ult budget                tokens per turn and top costs for this chat
  ult sync export|import    copy lessons to or from a private folder you choose
  ult upstreams             upstream sources, pins, licences and decisions
  ult arch [check|baseline]  architecture checks: cycles, duplication, size, stubs, naming, drift
  ult update status|setup   installed vs available version; auto-update setup
  ult website "<task>"      Website workflow plan: size, team, designer, roles, files to load
  ult motion "<task>"       Motion Graphics plan: size, roles, storyboard gate, renderer, files to load
  ult film "<task>"         Brand Film plan: sub-genre, gates, roles; --check the footage manifest and voiceover pace
  ult beats FILE            suggested beats (librosa) or possible cues (ffmpeg) to check by ear
  ult media FILE            check a video export: duration, size, fps, codecs, audio, loudness
  ult loop add|triage|fixed|recheck|status   review loop: blockers hold delivery, minor ones don't
  ult board add|move|show|card              card board for big projects; `show` first after lost context
  ult notes add|show|list|links            linked [[name]] notes (opens as an Obsidian vault)
  ult gate status|check|approve|revise|done ITEM   user approvals (brief, mockup, storyboard, story, sourcing, animatic, video, publish, deploy)
  ult launch | ult business "<task>" | ult social "<task>"   Launch Manager board, Business and Social Media plans
  ult shop catalog|numbers|check|emails|scaffold|test-order   store files for E-commerce Launch
  ult posts specs|check|calendar|slides|captions|variant   finished social posts and their results
  ult style status|apply|remove  opt-in shared answer style in ~/.claude/CLAUDE.md
"""
import argparse
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from ultlib import context, doctor, handoff, repomap, run, search, store, usage  # noqa: E402

MODULES = [run, search, repomap, store, handoff, doctor, usage, context]
for optional in ("scan", "findings", "route", "components", "learn", "budget", "sync", "upstreams", "update", "arch", "audit", "website", "motion", "film", "media", "loop", "board", "style", "gates", "teams", "shop", "posts"):
    try:
        MODULES.append(__import__(f"ultlib.{optional}", fromlist=["register"]))
    except ImportError:
        pass


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="ult", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for m in MODULES:
        m.register(sub)
    args = ap.parse_args(argv)
    try:
        return int(args.func(args) or 0)
    except BrokenPipeError:
        return 0
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
